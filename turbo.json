{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "with": ["server#dev:jobs", "server#dev:cron"]
    },
    "dev:jobs": {
      "persistent": true,
      "cache": false
    },
    "dev:cron": {
      "persistent": true,
      "cache": false
    }
  }
}
