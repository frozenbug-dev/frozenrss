{
  "name": "server",
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "dev:jobs": "tsx --watch src/server.jobs.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "NODE_OPTIONS='--import tsx' drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:migrate": "NODE_OPTIONS='--import tsx' drizzle-kit migrate --config src/db/drizzle.config.ts",
    "db:studio": "NODE_OPTIONS='--import tsx' drizzle-kit studi --config src/db/drizzle.config.tso"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@hono/zod-openapi": "^1.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@openworkflow/cli": "^0.4.4",
    "@scalar/hono-api-reference": "^0.10.13",
    "aws4fetch": "^1.0.20",
    "better-auth": "catalog:",
    "cron": "^4.4.0",
    "date-fns": "^4.1.0",
    "defuddle": "^0.18.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "feedparser": "^2.3.1",
    "hono": "^4.12.16",
    "ky": "^2.0.2",
    "linkedom": "^0.18.12",
    "nodemailer": "^8.0.7",
    "openworkflow": "^0.9.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "postgres": "^3.4.9",
    "slugify": "^1.6.9",
    "turndown": "^7.2.4",
    "unstorage": "^1.17.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "@types/turndown": "^5.0.6",
    "tsx": "catalog:",
    "type-fest": "^5.6.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
